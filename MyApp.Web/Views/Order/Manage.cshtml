@model IEnumerable<MyApp.Web.Models.Order>

@{
    ViewData["Title"] = "Order Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Order Management</h2>
            <p class="text-muted mb-0">
                Manage customer orders and update order status.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- Search & Filter -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Manage"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-6">

                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Order ID, username or email" />

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="All">
                                All
                            </option>

                            <option value="Pending"
                                    selected="@(ViewBag.Status == "Pending")">
                                Pending
                            </option>

                            <option value="Confirmed"
                                    selected="@(ViewBag.Status == "Confirmed")">
                                Confirmed
                            </option>

                            <option value="Shipped"
                                    selected="@(ViewBag.Status == "Shipped")">
                                Shipped
                            </option>

                            <option value="Delivered"
                                    selected="@(ViewBag.Status == "Delivered")">
                                Delivered
                            </option>

                            <option value="Cancelled"
                                    selected="@(ViewBag.Status == "Cancelled")">
                                Cancelled
                            </option>

                        </select>

                    </div>


                    <div class="col-md-3">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Search
                            </button>

                            <a asp-action="Manage"
                               class="btn btn-outline-secondary">
                                Clear
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Orders Table -->

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Order ID</th>

                            <th>Customer</th>

                            <th>Email</th>

                            <th>Order Date</th>

                            <th>Total</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-4">

                                    No orders found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            #@order.Id
                                        </strong>
                                    </td>


                                    <td>
                                        @order.User?.Username
                                    </td>


                                    <td>
                                        @order.User?.Email
                                    </td>


                                    <td>
                                        @order.OrderDate.ToString(
                                        "dd MMM yyyy, hh:mm tt")
                            </td>


                            <td>
                                <strong>
                                    ₹@order.TotalAmount.ToString("N2")
                                </strong>
                            </td>


                            <td>

                                @if (order.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (order.Status == "Confirmed")
                                        {
                                            <span class="badge bg-primary">
                                                Confirmed
                                            </span>
                                        }
                                        else if (order.Status == "Shipped")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Shipped
                                            </span>
                                        }
                                        else if (order.Status == "Delivered")
                                        {
                                            <span class="badge bg-success">
                                                Delivered
                                            </span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <a asp-action="AdminDetails"
                                           asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>