@model MyApp.Web.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">

    <!-- Back Button -->

    <div class="mb-3">

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Products
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                


                <!-- Product Information -->

                <div class="container py-5">

                    <div class="bg-white rounded-4 p-4 p-lg-5 shadow-sm">

                        <div class="row g-5 align-items-center">

                            <div class="col-lg-6">

                                <div class="product-image-wrapper"
                                     style="height:450px;border-radius:15px;">

                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl"
                                             class="product-image"
                                             alt="@Model.Name" />
                                    }
                                    else
                                    {
                                        <div class="d-flex
                                        align-items-center
                                        justify-content-center
                                        h-100">

                                            <i class="bi bi-image"
                                               style="font-size:80px;color:#ccc;">
                                            </i>

                                        </div>
                                    }

                                </div>

                            </div>


                            <div class="col-lg-6">

                                @if (Model.SubCategory != null)
                                {
                                    <div class="text-muted mb-2">

                                        @Model.SubCategory.Category.Name
                                        /
                                        @Model.SubCategory.Name

                                    </div>
                                }

                                <h1 class="fw-bold">
                                    @Model.Name
                                </h1>

                                <h2 class="fw-bold mt-3">
                                    ₹@Model.Price.ToString("N2")
                                </h2>

                                <hr />

                                <h5 class="fw-bold">
                                    Description
                                </h5>

                                <p class="text-muted"
                                   style="line-height:1.8;">

                                    @Model.Description

                                </p>

                                <div class="d-flex gap-2 mt-4">

                                    <a asp-controller="Cart"
                                       asp-action="Add"
                                       asp-route-productId="@Model.Id"
                                       class="btn btn-myapp btn-lg">

                                        <i class="bi bi-cart-plus me-2"></i>
                                        Add to Cart

                                    </a>

                                    <a asp-controller="Wishlist"
                                       asp-action="Add"
                                       asp-route-productId="@Model.Id"
                                       class="btn btn-outline-danger btn-lg">

                                        <i class="bi bi-heart me-2"></i>
                                        Wishlist

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>