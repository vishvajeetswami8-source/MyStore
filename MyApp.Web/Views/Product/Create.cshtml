@model MyApp.Web.Models.CreateProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Create Product</h2>
        <p class="text-muted mb-0">
            Add a new product with its category and image.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create"
                  asp-controller="Product"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>

                <!-- Product Name -->
                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter product name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter product description"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Price"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Price"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="Enter product price" />

                    <span asp-validation-for="Price"
                          class="text-danger">
                    </span>
                </div>

                <!-- Category / Subcategory -->
                <div class="mb-3">
                    <label asp-for="SubCategoryId"
                           class="form-label fw-semibold">
                        Category / Subcategory
                    </label>

                    <select asp-for="SubCategoryId"
                            class="form-select">

                        <option value="">
                            -- Select Subcategory --
                        </option>

                        @if (ViewBag.SubCategories != null)
                        {
                            foreach (var subCategory in ViewBag.SubCategories)
                            {
                                <option value="@subCategory.Id">
                                    @subCategory.Category.Name -
                                    @subCategory.Name
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="SubCategoryId"
                          class="text-danger">
                    </span>
                </div>

                <!-- Product Image -->
                <div class="mb-4">

                    <label asp-for="ImageFile"
                           class="form-label fw-semibold">
                        Product Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <small class="text-muted">
                        Upload JPG, JPEG, PNG or WEBP image.
                    </small>

                    <span asp-validation-for="ImageFile"
                          class="text-danger d-block">
                    </span>

                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-plus-circle me-1"></i>
                        Create Product

                    </button>

                    <a asp-action="Manage"
                       asp-controller="Product"
                       class="btn btn-secondary px-4">

                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}