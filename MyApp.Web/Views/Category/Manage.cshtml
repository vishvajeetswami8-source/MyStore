@model IEnumerable<MyApp.Web.Models.Category>

@{
    ViewData["Title"] = "Category Management";
}

<div class="category-management-page">

    <!-- Header -->
    <div class="category-page-header">

        <div>
            <div class="page-eyebrow">
                <i class="bi bi-grid-3x3-gap"></i>
                ADMIN PANEL
            </div>

            <h1>Category Management</h1>

            <p>
                Manage product categories and their subcategories.
            </p>
        </div>

        <div class="header-actions">

            <a asp-controller="Category"
               asp-action="Create"
               class="btn-category-primary">

                <i class="bi bi-plus-lg"></i>
                Add Category

            </a>

            <a asp-controller="Product"
               asp-action="Manage"
               class="btn-category-secondary">

                <i class="bi bi-box-seam"></i>
                Products

            </a>

        </div>

    </div>


    <!-- Statistics -->
    <div class="category-stats">

        <div class="category-stat-card">

            <div class="category-stat-icon">
                <i class="bi bi-grid"></i>
            </div>

            <div>
                <span>Total Categories</span>
                <strong>@Model.Count()</strong>
            </div>

        </div>


        <div class="category-stat-card">

            <div class="category-stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Active Categories</span>
                <strong>
                    @Model.Count(x => x.IsActive)
                </strong>
            </div>

        </div>


        <div class="category-stat-card">

            <div class="category-stat-icon">
                <i class="bi bi-diagram-3"></i>
            </div>

            <div>
                <span>Total Subcategories</span>
                <strong>
                    @Model.Sum(x => x.SubCategories.Count)
                </strong>
            </div>

        </div>


        <div class="category-stat-card">

            <div class="category-stat-icon">
                <i class="bi bi-layers"></i>
            </div>

            <div>
                <span>Category Groups</span>
                <strong>
                    @Model.Count()
                </strong>
            </div>

        </div>

    </div>


    <!-- Category List -->
    <div class="category-content-card">

        <div class="category-content-header">

            <div>
                <h2>All Categories</h2>
                <p>
                    Organize your products using categories and subcategories.
                </p>
            </div>

            <div class="category-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="categorySearch"
                       placeholder="Search category..."
                       onkeyup="filterCategories()" />

            </div>

        </div>


        @if (Model.Any())
        {
            <div class="category-table-wrapper">

                <table class="category-table">

                    <thead>

                        <tr>
                            <th>#</th>
                            <th>Category</th>
                            <th>Subcategories</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody id="categoryTableBody">

                        @{
                            int index = 1;
                        }

                        @foreach (var category in Model)
                        {
                            <tr class="category-row">

                                <!-- Number -->
                                <td class="category-number">
                                    @index
                                </td>

                                <!-- Category -->
                                <td>

                                    <div class="category-name-wrapper">

                                        <div class="category-icon-box">
                                            <i class="bi bi-grid-3x3-gap"></i>
                                        </div>

                                        <div>

                                            <div class="category-name">
                                                @category.Name
                                            </div>

                                           @*  <small>
                                                Category ID: @category.Id
                                            </small> *@

                                        </div>

                                    </div>

                                </td>


                                <!-- Subcategories -->
                                <td>

                                    @if (category.SubCategories != null &&
                                                                category.SubCategories.Any())
                                    {
                                        <div class="subcategory-list">

                                            @foreach (var subCategory
                                                                            in category.SubCategories)
                                            {
                                                <span class="subcategory-chip">

                                                    <i class="bi bi-tag"></i>

                                                    @subCategory.Name

                                                    <form asp-controller="Category"
                                                          asp-action="DeleteSubCategory"
                                                          asp-route-id="@subCategory.Id"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="subcategory-delete"
                                                                title="Delete subcategory"
                                                                onclick="return confirm('Are you sure you want to delete this subcategory?');">

                                                            <i class="bi bi-x"></i>

                                                        </button>

                                                    </form>

                                                </span>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-subcategory">
                                            No subcategories
                                        </span>
                                    }

                                </td>


                                <!-- Status -->
                                <td>

                                    @if (category.IsActive)
                                    {
                                        <span class="category-status active">
                                            <span class="status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="category-status inactive">
                                            <span class="status-dot"></span>
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="category-actions">

                                        <a asp-controller="Category"
                                           asp-action="CreateSubCategory"
                                           asp-route-categoryId="@category.Id"
                                           class="category-action add"
                                           title="Add Subcategory">

                                            <i class="bi bi-plus-lg"></i>

                                        </a>

                                        <a asp-controller="Category"
                                           asp-action="Create"
                                           asp-route-id="@category.Id"
                                           class="category-action edit"
                                           title="Edit Category">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            index++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- Empty State -->

            <div class="category-empty-state">

                <div class="empty-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>

                <h3>No Categories Found</h3>

                <p>
                    You haven't created any categories yet.
                </p>

                <a asp-controller="Category"
                   asp-action="Create"
                   class="btn-category-primary">

                    <i class="bi bi-plus-lg"></i>
                    Create First Category

                </a>

            </div>
        }

    </div>

</div>


@section Scripts
{
    <script>

        function filterCategories() {

            const input =
                document.getElementById("categorySearch");

            const filter =
                input.value.toLowerCase();

            const rows =
                document.querySelectorAll(".category-row");

            rows.forEach(function (row) {

                const text =
                    row.innerText.toLowerCase();

                if (text.includes(filter)) {
                    row.style.display = "";
                }
                else {
                    row.style.display = "none";
                }

            });
        }

    </script>
}