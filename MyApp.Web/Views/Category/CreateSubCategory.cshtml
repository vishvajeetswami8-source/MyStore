@{
    ViewData["Title"] = "Create Subcategory";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-header">
            <h4>
                Add Subcategory
            </h4>

            <small class="text-muted">
                Category: @ViewBag.Category.Name
            </small>
        </div>

        <div class="card-body">

            <form asp-action="CreateSubCategory"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="categoryId"
                       value="@ViewBag.Category.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Subcategory Name
                    </label>

                    <input name="name"
                           class="form-control"
                           placeholder="Example: Mobile" />

                    @Html.ValidationMessage(
                    "name",
                                        new { @class = "text-danger" })

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Add Subcategory
                </button>

                <a asp-action="Manage"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>