@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7 hero-content">

                <div class="mb-3">
                    <span class="badge rounded-pill text-bg-light">
                        <i class="bi bi-stars me-1"></i>
                        Your everyday marketplace
                    </span>
                </div>

                <h1>
                    Shop smarter.
                    <br />
                    Live <span>better.</span>
                </h1>

                <p>
                    Discover quality products across electronics,
                    fashion, home, beauty, groceries and more.
                    Everything you need, all in one place.
                </p>

                <div class="hero-buttons">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="hero-primary">

                        Explore Products
                        <i class="bi bi-arrow-right ms-2"></i>

                    </a>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="hero-secondary">

                        Browse Categories

                    </a>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="hero-shopping-icon">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- FEATURES -->

<section class="feature-strip">

    <div class="container">

        <div class="row g-4">

            <div class="col-md-4">

                <div class="feature-item">

                    <div class="feature-icon">
                        <i class="bi bi-truck"></i>
                    </div>

                    <div>
                        <h6>Fast Delivery</h6>
                        <span>Quick and reliable delivery</span>
                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-item">

                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>
                        <h6>Secure Shopping</h6>
                        <span>Your information stays protected</span>
                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-item">

                    <div class="feature-icon">
                        <i class="bi bi-headset"></i>
                    </div>

                    <div>
                        <h6>Customer Support</h6>
                        <span>We're here whenever you need us</span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- CATEGORIES -->

<section class="section">

    <div class="container">

        <div class="section-heading text-center">

            <h2>Shop by Category</h2>

            <p>
                Find exactly what you're looking for
            </p>

        </div>

        <div class="row g-3">

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-phone"></i>
                    </div>

                    <h5>Electronics</h5>

                </a>

            </div>

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-person-standing"></i>
                    </div>

                    <h5>Fashion</h5>

                </a>

            </div>

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-house"></i>
                    </div>

                    <h5>Home</h5>

                </a>

            </div>

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-heart-pulse"></i>
                    </div>

                    <h5>Health</h5>

                </a>

            </div>

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-basket"></i>
                    </div>

                    <h5>Groceries</h5>

                </a>

            </div>

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <h5>Beauty</h5>

                </a>

            </div>

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-book"></i>
                    </div>

                    <h5>Books</h5>

                </a>

            </div>

            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="category-card">

                    <div class="category-icon">
                        <i class="bi bi-trophy"></i>
                    </div>

                    <h5>Sports</h5>

                </a>

            </div>

        </div>

    </div>

</section>


<!-- CALL TO ACTION -->

<section class="section pt-0">

    <div class="container">

        <div class="p-5 text-center rounded-4"
             style="background:#ebe9ff;">

            <h2 class="fw-bold">
                Ready to find your next favorite product?
            </h2>

            <p class="text-muted mb-4">
                Explore our growing collection today.
            </p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-myapp">

                Start Shopping
                <i class="bi bi-arrow-right ms-2"></i>

            </a>

        </div>

    </div>

</section>