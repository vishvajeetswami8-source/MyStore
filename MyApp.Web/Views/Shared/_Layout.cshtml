@using Microsoft.AspNetCore.Http

@{
    var username = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
    var userId = Context.Session.GetInt32("UserId");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MyApp</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg myapp-navbar">

        <div class="container">

            <a class="navbar-brand myapp-logo"
               asp-controller="Home"
               asp-action="Index">

                <span class="logo-icon">
                    <i class="bi bi-bag-heart-fill"></i>
                </span>

                My<span>App</span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <i class="bi bi-list"></i>

            </button>

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <!-- LEFT -->

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Index">
                            Products
                        </a>
                    </li>

                    @if (userId != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Support"
                               asp-action="MyTickets">
                                Support
                            </a>
                        </li>
                    }

                    @if (role == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="User"
                               asp-action="Index">
                                Users
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Category"
                               asp-action="Manage">
                                Categories
                            </a>
                        </li>
                    }

                </ul>

                <!-- RIGHT -->

                <ul class="navbar-nav align-items-lg-center">

                    @if (userId != null)
                    {
                        <li class="nav-item">

                            <a class="nav-icon-link"
                               asp-controller="Wishlist"
                               asp-action="Index"
                               title="Wishlist">

                                <i class="bi bi-heart"></i>

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-icon-link"
                               asp-controller="Cart"
                               asp-action="Index"
                               title="Shopping Cart">

                                <i class="bi bi-cart3"></i>

                            </a>

                        </li>

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle user-menu"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <span class="user-avatar">
                                    <i class="bi bi-person"></i>
                                </span>

                                @username

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Settings"
                                       asp-action="Index">

                                        <i class="bi bi-gear me-2"></i>
                                        Settings

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Order"
                                       asp-action="MyOrders">

                                        <i class="bi bi-box-seam me-2"></i>
                                        My Orders

                                    </a>
                                </li>

                                @if (role == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Order"
                                           asp-action="Manage">

                                            <i class="bi bi-kanban me-2"></i>
                                            Order Management

                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Product"
                                           asp-action="Manage">

                                            <i class="bi bi-box-seam me-2"></i>
                                            Product Management

                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Support"
                                           asp-action="Manage">

                                            <i class="bi bi-headset me-2"></i>
                                            Support Management

                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="dropdown-item logout-item">

                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-light login-btn"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2">
                            <a class="btn register-btn"
                               asp-controller="Account"
                               asp-action="Register">
                                Create Account
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>

    </nav>


    <!-- PAGE CONTENT -->

    <main>
        @RenderBody()
    </main>


    <!-- FOOTER -->

    <footer class="myapp-footer">

        <div class="container">

            <div class="row g-4">

                <div class="col-lg-4">

                    <div class="footer-logo">
                        <i class="bi bi-bag-heart-fill"></i>
                        MyApp
                    </div>

                    <p>
                        Discover products you love, shop with confidence,
                        and enjoy a simple and secure shopping experience.
                    </p>

                </div>

                <div class="col-lg-2 col-md-4">

                    <h6>Shop</h6>

                    <a asp-controller="Product"
                       asp-action="Index">
                        Products
                    </a>

                    <a asp-controller="Product"
                       asp-action="Index">
                        Categories
                    </a>

                </div>

                <div class="col-lg-2 col-md-4">

                    <h6>Account</h6>

                    <a asp-controller="Order"
                       asp-action="MyOrders">
                        My Orders
                    </a>

                    <a asp-controller="Settings"
                       asp-action="Index">
                        Settings
                    </a>

                </div>

                <div class="col-lg-2 col-md-4">

                    <h6>Support</h6>

                    <a asp-controller="Support"
                       asp-action="MyTickets">
                        Help Center
                    </a>

                    <a asp-controller="Support"
                       asp-action="Create">
                        Contact Us
                    </a>

                </div>

            </div>

            <hr />

            <div class="footer-bottom">

                <span>
                    © @DateTime.Now.Year MyApp. All rights reserved.
                </span>

                <span>
                    Built with ASP.NET Core
                </span>

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>