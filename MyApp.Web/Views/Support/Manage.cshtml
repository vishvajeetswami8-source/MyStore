@model IEnumerable<MyApp.Web.Models.SupportTicket>

@{
    ViewData["Title"] = "Support Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Support Management</h2>

    </div>


    <form asp-action="Manage"
          method="get"
          class="mb-4">

        <div class="row g-2">

            <div class="col-md-7">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by Ticket ID, Username or Email..." />

            </div>


            <div class="col-md-3">

                <select name="status"
                        class="form-select">

                    <option value="All">
                        All Statuses
                    </option>

                    <option value="Open">
                        Open
                    </option>

                    <option value="In Progress">
                        In Progress
                    </option>

                    <option value="Resolved">
                        Resolved
                    </option>

                    <option value="Closed">
                        Closed
                    </option>

                </select>

            </div>


            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-primary w-100">
                    🔍 Search
                </button>

            </div>

        </div>

    </form>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No support requests found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Ticket</th>
                        <th>User</th>
                        <th>Subject</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var ticket in Model)
                    {
                        <tr>

                            <td>
                                #@ticket.Id
                            </td>

                            <td>
                                @ticket.User?.Username
                                <br />

                                <small class="text-muted">
                                    @ticket.User?.Email
                                </small>
                            </td>

                            <td>
                                @ticket.Subject
                            </td>

                            <td>
                                @ticket.Priority
                            </td>

                            <td>
                                @ticket.Status
                            </td>

                            <td>
                                @ticket.CreatedDate.ToString(
                                "dd MMM yyyy HH:mm")
                    </td>

                    <td>

                        <a asp-action="AdminDetails"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-primary">
                            View / Reply
                        </a>

                    </td>

                </tr>
                                }

                </tbody>

            </table>

        </div>
    }

</div>